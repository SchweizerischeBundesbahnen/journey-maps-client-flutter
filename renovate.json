{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "fvm": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Flutter SDK updates are driven by the nightly support-window check, not by Renovate.",
      "matchDatasources": [
        "flutter-version"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "pub"
      ],
      "groupName": "envied",
      "matchPackageNames": [
        "envied",
        "envied_generator"
      ]
    }
  ],
  "rebaseWhen": "conflicted",
  "prConcurrentLimit": 5
}
