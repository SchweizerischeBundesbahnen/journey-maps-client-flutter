**.DS_Store

# No generated srcs
build/
.flutter-plugins
.flutter-plugins-dependencies

# No generated files
**/*.mocks.dart

# for example
example/.fvm/*

# FVM Version Cache. .fvmrc is tracked: it is the canonical toolchain version
